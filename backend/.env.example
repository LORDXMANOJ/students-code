# Server Port (Defaults to 3000 if not specified)
PORT=3000

# Secret key for JWT signing & verification (Change this to a strong random secret in production)
JWT_SECRET=your_jwt_secret_key_here

# Node environment mode: development | production
NODE_ENV=production

# Allowed client origins for CORS (comma-separated for multiple origins, e.g. https://my-frontend.vercel.app,http://localhost:4200)
CLIENT_URL=http://localhost:4200

# SQLite database file path (Defaults to file:./dev.db)
DATABASE_URL=file:./dev.db
